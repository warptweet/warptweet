# Copy to config.env (gitignored) or export before orchestrate.sh.
# Phase A: local Mac client + remote Linux server, package install from artifacts,
# ssh-agent auth, deterministic echo fixture.

# --- Remote Linux server (admin SSH) ---
WARPTWEET_INTEROP_SERVER_HOST=linux.example.com
WARPTWEET_INTEROP_SERVER_USER=ubuntu
# Empty = default ssh (agent). Optional explicit key still uses agent for passphrase.
WARPTWEET_INTEROP_SSH_IDENTITY=
WARPTWEET_INTEROP_SSH_PORT=22
# Require one of: pre-provisioned known_hosts, or pinned host-key fingerprint
# (SHA256:… from ssh-keygen -lf). StrictHostKeyChecking=yes always.
WARPTWEET_INTEROP_SSH_KNOWN_HOSTS=
WARPTWEET_INTEROP_SSH_HOST_KEY_FINGERPRINT=

# --- Pins (required) ---
WARPTWEET_RELEASE_VERSION=0.1.0-dev
# 40 lowercase hex
WARPTWEET_SOURCE_COMMIT=
WARPTWEET_CLIENT_ARTIFACT_PROFILE_ID=darwin-arm64
WARPTWEET_SERVER_ARTIFACT_PROFILE_ID=linux-amd64

# Package and engine digests expected after install (64 lowercase hex)
WARPTWEET_CLIENT_PACKAGE_SHA256=
WARPTWEET_SERVER_PACKAGE_SHA256=
WARPTWEET_CLIENT_ENGINE_MANIFEST_SHA256=
WARPTWEET_SERVER_ENGINE_MANIFEST_SHA256=

# --- Artifacts directory (Option B: install from pinned files) ---
# Layout (example):
#   $WARPTWEET_INTEROP_ARTIFACTS/
#     warptweet_${VERSION}_amd64.deb
#     warptweet-client_${VERSION}_arm64.pkg
#     SHA256SUMS
WARPTWEET_INTEROP_ARTIFACTS=
WARPTWEET_INTEROP_SERVER_PACKAGE_FILE=
WARPTWEET_INTEROP_CLIENT_PACKAGE_FILE=

# Installed controller paths after package install
WARPTWEET_INTEROP_SERVER_CTRL=/opt/warptweet/bin/warptweet
WARPTWEET_INTEROP_CLIENT_CTRL="/Library/Application Support/WarpTweet/bin/warptweet"

# --- Host / fixture ---
# LISTEN is the guest bind (numeric IP on the NIC). Required.
WARPTWEET_INTEROP_SERVER_LISTEN=
# ADVERTISE is the published data dial. Unset by default. Pass --advertise
# only when this is set. Never default ADVERTISE=LISTEN.
# WARPTWEET_INTEROP_SERVER_ADVERTISE=34.20.174.226:2222
# Optional independent enrollment bind/dial.
# WARPTWEET_INTEROP_ENROLL_LISTEN=10.168.0.2:29722
# WARPTWEET_INTEROP_ENROLL_ADVERTISE=34.20.174.226:29722
# Evidence cell classification. A darwin-arm64 × linux-arm64 run with
# ADVERTISE ≠ LISTEN (IP literal) is auto-classified as matrix,networking
# with WARPTWEET_INTEROP_NETWORKING_CELL_ID=gce-one-to-one-nat.
# WARPTWEET_INTEROP_CELL_CLASSES=matrix,networking
# WARPTWEET_INTEROP_NETWORKING_CELL_ID=gce-one-to-one-nat
# WARPTWEET_INTEROP_PUBLICATION_MODEL=one_to_one_nat
# Echo target on the server (loopback). host --to this port.
WARPTWEET_INTEROP_ECHO_PORT=18432
WARPTWEET_INTEROP_CLIENT_NAME=interop-mac

# Working directory for invites and logs (created)
WARPTWEET_INTEROP_WORK=

# Evidence output path (must not already exist)
WARPTWEET_INTEROP_EVIDENCE_OUTPUT=

# Phase A stops after payload. Set 1 to attempt rotate/revoke after connect.
WARPTWEET_INTEROP_RUN_LIFECYCLE=0

# Fresh Ubuntu VPS (destroyed/replaced often):
#   make lab-host
# or scripts/interop/provision-lab-host.sh
# Same Docker+Postgres helpers run from orchestrate.sh on the first make interop.
