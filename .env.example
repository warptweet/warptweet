# Local dual-host interop happy path (gitignored as .env).
# Copy: cp .env.example .env
# Run:  make interop
#
# Minimal required fields are marked REQUIRED. Everything else has local-dev defaults.

# --- REQUIRED: remote Linux server ---
WARPTWEET_INTEROP_SERVER_HOST=203.0.113.10
WARPTWEET_INTEROP_SERVER_USER=ubuntu

# --- REQUIRED for make linux-rc: signing key fingerprint ---
# WARPTWEET_LINUX_GPG_KEY=7738DDB55DE99435

# --- REQUIRED: SSH key path on this Mac (loaded via ssh-agent; unlock once with ssh-add) ---
WARPTWEET_INTEROP_SSH_IDENTITY=$HOME/.ssh/id_ed25519
WARPTWEET_INTEROP_SSH_PORT=22

# Host identity (one of these). For local lab only, leave both empty to TOFU via keyscan for this run.
# WARPTWEET_INTEROP_SSH_KNOWN_HOSTS=$HOME/.ssh/known_hosts
# WARPTWEET_INTEROP_SSH_HOST_KEY_FINGERPRINT=SHA256:xxxxxxxx

# Package artifacts directory (created). If empty of .deb/.pkg, make interop builds them.
WARPTWEET_INTEROP_ARTIFACTS=$PWD/artifacts
# Server package build: remote (native on SERVER_HOST; preferred on multi-core amd64),
# docker (linux/amd64; slow under Rosetta on Apple Silicon), or auto (docker if present).
WARPTWEET_INTEROP_BUILD_SERVER=remote
# Cache for OpenSSH/OpenSSL sources and macOS stages (reused across runs).
# WARPTWEET_INTEROP_BUILD_CACHE=$PWD/.cache/interop-build
# Official Go toolchain installed on remote when missing (must satisfy go.mod).
# WARPTWEET_INTEROP_GO_VERSION=1.26.5

# Optional explicit names (otherwise auto-picked: first *.deb/*.rpm and first *.pkg)
# WARPTWEET_INTEROP_SERVER_PACKAGE_FILE=warptweet_0.1.0-dev_amd64.deb
# WARPTWEET_INTEROP_CLIENT_PACKAGE_FILE=warptweet-client_0.1.0-dev_arm64.pkg

# WarpTweet SSH listen on the server (default: $HOST:2222)
# WARPTWEET_INTEROP_SERVER_LISTEN=203.0.113.10:2222

# Optional pins (default: git HEAD + digests of artifact files; engine digests after install)
# WARPTWEET_SOURCE_COMMIT=
# WARPTWEET_RELEASE_VERSION=0.1.0-dev
# WARPTWEET_CLIENT_PACKAGE_SHA256=
# WARPTWEET_SERVER_PACKAGE_SHA256=

# Optional: run rotate/revoke after connect (0/1)
# WARPTWEET_INTEROP_RUN_LIFECYCLE=0

# Reinstall same-version packages instead of reusing the installed payload.
# WARPTWEET_INTEROP_FORCE_SERVER_REINSTALL=1
# WARPTWEET_INTEROP_FORCE_CLIENT_REINSTALL=1
