{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warptweet.com/schemas/release-evidence-index-v3.schema.json",
  "title": "WarpTweet release evidence index v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "contract_id",
    "contract_checklist_sha256",
    "reports"
  ],
  "properties": {
    "kind": {
      "const": "warptweet.release-evidence-index"
    },
    "schema_version": {
      "const": 3
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_checklist_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://warptweet.com/schemas/release-evidence-v3.schema.json"
      }
    }
  }
}
