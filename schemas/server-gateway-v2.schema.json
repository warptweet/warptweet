{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warptweet.com/schemas/server-gateway-v2.schema.json",
  "title": "WarpTweet server gateway manifest v2",
  "description": "Machine-readable shape for the warptweet.server-gateway v2 member of the WarpTweet Tunnel Manifest family. Bind and dial are independent. Identity is not a locator.",
  "$comment": "Runtime validation remains authoritative for canonical path semantics and path-to-user correspondence, numeric IP semantics and address safety, DNS A-label canonicalization, duration bounds where applicable to the manifest family, published_endpoint_generation ownership, and duplicate JSON object member names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "profile_id",
    "sshd_binary_sha256",
    "openssh_bundle_manifest_sha256",
    "network",
    "target",
    "dedicated_user",
    "host_key_path",
    "authorized_keys_path"
  ],
  "properties": {
    "kind": {
      "const": "warptweet.server-gateway"
    },
    "schema_version": {
      "const": 2
    },
    "profile_id": {
      "const": "warptweet-tcp1-openssh10.4p1-openssl3.5.7-mlkem768x25519-mldsa44-ed25519-chacha20"
    },
    "sshd_binary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "openssh_bundle_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "network": {
      "$ref": "#/$defs/network"
    },
    "target": {
      "$ref": "#/$defs/bind_endpoint"
    },
    "dedicated_user": {
      "$ref": "#/$defs/dedicated_user"
    },
    "host_key_path": {
      "const": "/var/lib/warptweet/ssh/ssh_host_mldsa44_ed25519_key",
      "description": "Filesystem reference only. Private-key material must never be embedded in a manifest."
    },
    "authorized_keys_path": {
      "$ref": "#/$defs/authorized_keys_path"
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "minLength": 2,
      "maxLength": 45,
      "pattern": "^[0-9A-Fa-f:.]+$",
      "$comment": "Runtime validation is authoritative for numeric IPv4 or IPv6 parsing, zone rejection, canonical rendering, and address-class safety."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dedicated_user": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
      "not": {
        "enum": [
          "root",
          "daemon",
          "nobody",
          "sshd",
          "_sshd"
        ]
      }
    },
    "authorized_keys_path": {
      "type": "string",
      "pattern": "^/var/lib/warptweet/authorized_keys/[a-z_][a-z0-9_-]{0,31}$",
      "$comment": "Runtime validation requires the final path component to equal dedicated_user exactly."
    },
    "bind_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "port"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "dial_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "$comment": "Runtime validation is authoritative for IP versus DNS, A-label canonicalization, and address-class safety."
    },
    "dial_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "port"
      ],
      "properties": {
        "host": {
          "$ref": "#/$defs/dial_host"
        },
        "port": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "service_endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listen",
        "dial"
      ],
      "properties": {
        "listen": {
          "$ref": "#/$defs/bind_endpoint"
        },
        "dial": {
          "$ref": "#/$defs/dial_endpoint"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published_endpoint_generation",
        "data",
        "enrollment"
      ],
      "properties": {
        "published_endpoint_generation": {
          "type": "integer",
          "minimum": 1,
          "$comment": "Server-generated only. Runtime rejects decrement and uint64 overflow on increment."
        },
        "data": {
          "$ref": "#/$defs/service_endpoints"
        },
        "enrollment": {
          "$ref": "#/$defs/service_endpoints"
        }
      }
    }
  }
}
