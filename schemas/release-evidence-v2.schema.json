{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warptweet.com/schemas/release-evidence-v2.schema.json",
  "title": "WarpTweet release evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "contract_id",
    "contract_checklist_sha256",
    "release_version",
    "source_commit",
    "clean_tree_proof",
    "client_package_sha256",
    "server_package_sha256",
    "client_artifact_profile_id",
    "server_artifact_profile_id",
    "client_engine_manifest_sha256",
    "server_engine_manifest_sha256",
    "client_platform",
    "server_platform",
    "client_architecture",
    "server_architecture",
    "host_target",
    "authorization_policy",
    "route_count",
    "restart_policies",
    "test_identity",
    "commands",
    "started_at",
    "finished_at",
    "results",
    "package_to_package",
    "source_tree_substitution"
  ],
  "properties": {
    "kind": {
      "const": "warptweet.release-evidence"
    },
    "schema_version": {
      "const": 2
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_checklist_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_version": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "clean_tree_proof": {
      "type": "string",
      "minLength": 1
    },
    "client_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "server_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_artifact_profile_id": {
      "type": "string",
      "enum": ["darwin-arm64", "darwin-amd64", "linux-amd64", "linux-arm64"]
    },
    "server_artifact_profile_id": {
      "type": "string",
      "enum": ["linux-amd64", "linux-arm64"]
    },
    "client_engine_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "server_engine_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "client_platform": {
      "type": "string",
      "minLength": 1
    },
    "server_platform": {
      "type": "string",
      "minLength": 1
    },
    "client_architecture": {
      "type": "string",
      "minLength": 1
    },
    "server_architecture": {
      "type": "string",
      "minLength": 1
    },
    "host_target": {
      "type": "string",
      "minLength": 1
    },
    "authorization_policy": {
      "type": "string",
      "minLength": 1
    },
    "route_count": {
      "type": "integer",
      "minimum": 0
    },
    "restart_policies": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["unless-stopped", "manual"]
      }
    },
    "test_identity": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_identity": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "redacted_log_path": {
      "type": "string"
    },
    "package_to_package": {
      "const": true
    },
    "source_tree_substitution": {
      "const": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "class", "status"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "type": "string",
            "enum": ["positive", "negative"]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "blocked", "not_run"]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
