[Unit]
Description=WarpTweet client route reconciler
After=network-online.target warptweet-provisioner.service
Requires=warptweet-provisioner.service
Wants=network-online.target
AssertFileIsExecutable=/opt/warptweet/bin/warptweet
DefaultDependencies=yes

[Service]
Type=oneshot
KillMode=control-group
User=root
Group=root
ExecStart=/opt/warptweet/bin/warptweet reconcile
RemainAfterExit=yes
TimeoutStartSec=600
StandardInput=null
StandardOutput=journal
StandardError=journal
UnsetEnvironment=DISPLAY LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD OPENSSL_CONF OPENSSL_CONF_INCLUDE OPENSSL_MODULES SSH_ASKPASS SSH_ASKPASS_REQUIRE SSH_AUTH_SOCK
AmbientCapabilities=
CapabilityBoundingSet=
NoNewPrivileges=yes
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/warptweet
ReadWritePaths=/etc/warptweet /run/warptweet
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=64

[Install]
WantedBy=multi-user.target
