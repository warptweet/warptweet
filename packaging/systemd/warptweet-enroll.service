[Unit]
Description=WarpTweet enrollment control plane
Documentation=https://warptweet.com/
After=network-online.target
Wants=network-online.target
AssertFileIsExecutable=/opt/warptweet/bin/warptweet
AssertPathExists=/etc/warptweet/server.wt
AssertPathExists=/opt/warptweet/etc/ssh_host_mldsa44_ed25519_key
AssertPathExists=/etc/warptweet/invite.mac-key
AssertPathExists=/etc/warptweet/enrollment/tls.crt
AssertPathExists=/etc/warptweet/enrollment/tls.key
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/opt/warptweet/bin/warptweet doctor-server --config /etc/warptweet/server.wt
ExecStart=/opt/warptweet/bin/warptweet server enroll-listen
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
UnsetEnvironment=LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD OPENSSL_CONF OPENSSL_CONF_INCLUDE OPENSSL_MODULES

# Enrollment mutates invite/client state and the managed authorized_keys file.
CapabilityBoundingSet=CAP_KILL CAP_NET_BIND_SERVICE
AmbientCapabilities=
NoNewPrivileges=yes
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RuntimeDirectory=warptweet/server
RuntimeDirectoryMode=0750
ReadOnlyPaths=/opt/warptweet /etc/warptweet
ReadWritePaths=/var/lib/warptweet /opt/warptweet/etc/authorized_keys /etc/warptweet/enrollment /run/warptweet/server
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=64

[Install]
WantedBy=multi-user.target
