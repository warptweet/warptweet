[Unit]
Description=WarpTweet localhost management RPC
Documentation=https://warptweet.com/
After=network-online.target
Wants=network-online.target
AssertFileIsExecutable=/opt/warptweet/bin/warptweet
AssertPathExists=/etc/warptweet/server.wt
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=warptweet-sshd
ExecStartPre=/opt/warptweet/bin/warptweet doctor-server --config /etc/warptweet/server.wt
ExecStart=/opt/warptweet/bin/warptweet server mgmt-listen --listen 127.0.0.1:29723
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
UnsetEnvironment=LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD OPENSSL_CONF OPENSSL_CONF_INCLUDE OPENSSL_MODULES
CapabilityBoundingSet=CAP_KILL CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=yes
KeyringMode=private
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RuntimeDirectory=warptweet/server
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ReadOnlyPaths=/opt/warptweet /etc/warptweet
ReadWritePaths=/var/lib/warptweet /run/warptweet/server /run/warptweet/sshd
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
TasksMax=64

[Install]
WantedBy=multi-user.target
