#!/bin/sh
set -eu
LC_ALL=C
export LC_ALL

# preinstall runs as root during package installation. It must not contact the
# network, download artifacts, or mutate identity material.

if [ "$(uname -s)" != Darwin ]; then
    echo "WarpTweet macOS package requires Darwin" >&2
    exit 1
fi
if [ "$(id -u)" != "0" ]; then
    echo "WarpTweet macOS package preinstall requires root" >&2
    exit 1
fi

# Refuse to proceed if a server daemon unit is somehow present in the payload
# staging area. Client packages never install sshd helpers.
if [ -e "/Library/Application Support/WarpTweet/libexec/openssh/sbin/sshd" ]; then
    echo "refusing install: server helper path already present" >&2
    exit 1
fi

exit 0
