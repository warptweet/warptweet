--- a/monitor.c
+++ b/monitor.c
@@ -96,6 +96,7 @@
 #include "ssherr.h"
 #include "sk-api.h"
 #include "srclimit.h"
+#include "warptweet-grant.h"
 
 #ifdef GSSAPI
 static Gssctxt *gsscontext = NULL;
@@ -1601,8 +1602,13 @@ mm_answer_keyverify(struct ssh *ssh, int sock, struct sshbuf *m)
 	}
 	auth2_record_key(authctxt, ret == 0, key);
 
-	if (key_blobtype == MM_USERKEY && ret == 0)
+	if (key_blobtype == MM_USERKEY && ret == 0) {
+		if (warptweet_grant_register(blob, bloblen) != 0) {
+			error("WarpTweet grant registration rejected public key");
+			ret = -1;
+		} else
 			auth_activate_options(ssh, key_opts);
+	}
 	monitor_reset_key_state();
 
 	sshbuf_reset(m);
@@ -1773,6 +1779,7 @@ mm_answer_term(struct ssh *ssh, int sock, struct sshbuf *req)
 	res = WIFEXITED(status) ? WEXITSTATUS(status) : 1;
 
 	/* Terminate process */
+	warptweet_grant_unregister();
 	exit(res);
 }
 
--- a/sshd-session.c
+++ b/sshd-session.c
@@ -95,6 +95,7 @@
