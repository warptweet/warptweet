---
const features = [
  {
    number: "01",
    title: "Hybrid by design",
    body: "Post-quantum and classical cryptography establish every tunnel and authenticate both machines together."
  },
  {
    number: "02",
    title: "Endpoint identities",
    body: "Host and connect each create a composite identity on the machine that runs them. Private keys never leave that machine."
  },
  {
    number: "03",
    title: "Named routes",
    body: "Each tunnel has a memorable ID, a local listener on your laptop, and exactly one authorized destination service."
  },
  {
    number: "04",
    title: "Any TCP application",
    body: "Point databases, APIs, and dev tools at localhost. WarpTweet carries the path; the app stays ordinary."
  },
  {
    number: "05",
    title: "Two commands",
    body: "Run host beside the service, then connect from your laptop. Status and teardown stay available when you need them."
  },
  {
    number: "06",
    title: "Open infrastructure",
    body: "The controller, schemas, cryptographic profile, packaging, and system design are available in public source."
  }
];
---

<div class="feature-grid">
  {features.map((feature) => (
    <article class="feature-card">
      <span>{feature.number}</span>
      <h3>{feature.title}</h3>
      <p>{feature.body}</p>
    </article>
  ))}
</div>
