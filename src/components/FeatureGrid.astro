---
const features = [
  {
    number: "01",
    title: "One exact service",
    body: "Each grant reaches one declared TCP destination. It does not become access to the host or the rest of its network."
  },
  {
    number: "02",
    title: "Ordinary applications",
    body: "Point databases, APIs, SDKs, and development tools at localhost. WarpTweet carries TCP; your application stays unchanged."
  },
  {
    number: "03",
    title: "Single-use invites",
    body: "The host mints a short-lived confidential invite for one enrollment. Reusing or altering it fails closed."
  },
  {
    number: "04",
    title: "Durable lifecycle",
    body: "Inspect status, stop and restore routes, rotate identity, revoke access, and let host-enforced grants expire."
  },
  {
    number: "05",
    title: "Cloud-aware endpoints",
    body: "Publish through direct addresses, one-to-one NAT, mapped ports, DNS locators, or IPv6 without confusing location with identity."
  },
  {
    number: "06",
    title: "Hybrid endpoint identity",
    body: "Post-quantum and classical algorithms establish the connection and authenticate both machines together."
  }
];
---

<div class="feature-grid">
  {features.map((feature) => (
    <article class="feature-card">
      <span>{feature.number}</span>
      <h3>{feature.title}</h3>
      <p>{feature.body}</p>
    </article>
  ))}
</div>
