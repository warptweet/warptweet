---
import {
  distributionMessage,
  enrollCommand,
  homebrewCommand,
  publicDistributionReady,
  qualificationComplete,
  qualificationMessage
} from "../lib/install";

const connectCommand = enrollCommand
  .replace("warptweet connect ", "warptweet connect --listen-port 15432 ")
  .replace("<invite-file>", "staging-db.wtinvite");
---

<div class="start-panel">
  <div class="start-panel__heading">
    <div>
      <p class="section-kicker">First-edition setup</p>
      <h2 id="start-title">Two machines. Two commands. One private route.</h2>
    </div>
    <div class="release-state" role="status">
      <span class:list={{ "release-state__dot": true, "release-state__dot--complete": qualificationComplete }}></span>
      <div>
        <strong>{qualificationComplete ? qualificationMessage : "Package qualification in progress"}</strong>
        <p>{publicDistributionReady ? "Public installation is available." : distributionMessage}</p>
      </div>
    </div>
  </div>

  <div class="machine-setup-grid">
    <article class="setup-card setup-card--host">
      <header>
        <span>01</span>
        <div>
          <p>Machine with the service</p>
          <h3>Linux host</h3>
        </div>
        <small>AMD64 · ARM64</small>
      </header>
      {
        publicDistributionReady ? (
          <p class="setup-card__install">
            Install the signed <code>.deb</code> for this machine from the release page.
          </p>
        ) : (
          <p class="setup-card__install">Signed Linux release packages are being prepared.</p>
        )
      }
      <p class="setup-card__label">Then authorize one local service:</p>
      <pre tabindex="0" aria-label="WarpTweet Linux host command"><code>warptweet host --to 127.0.0.1:5432 --name staging-db</code></pre>
      <p class="setup-card__result">Creates <code>staging-db.wtinvite</code>, a confidential single-use invite.</p>
    </article>

    <article class="setup-card setup-card--client">
      <header>
        <span>02</span>
        <div>
          <p>Your workstation</p>
          <h3>Apple Silicon Mac</h3>
        </div>
        <small>macOS 13+</small>
      </header>
      {
        publicDistributionReady ? (
          <div class="install-command" data-install-command>
            <pre tabindex="0" aria-label="Homebrew install command"><code>{homebrewCommand}</code></pre>
            <button type="button" class="button button--paper install-copy" data-copy-command={homebrewCommand}>
              Copy
            </button>
          </div>
        ) : (
          <p class="setup-card__install">The Homebrew command appears here after clean-install proof passes.</p>
        )
      }
      <p class="setup-card__label">Connect with the invite:</p>
      <pre tabindex="0" aria-label="WarpTweet Mac connect command"><code>{connectCommand}</code></pre>
      <p class="setup-card__result">Your application connects to <code>127.0.0.1:15432</code>.</p>
    </article>
  </div>

  <div class="start-panel__next">
    <p><strong>Use it normally.</strong> Try <code>psql "host=127.0.0.1 port=15432 dbname=app"</code>.</p>
    <a href="https://github.com/warptweet/warptweet/blob/main/docs/2026-08-16_product-quickstart.md">Read the complete quickstart</a>
  </div>
</div>

<p class="visually-hidden" aria-live="polite" data-copy-status></p>

{
  publicDistributionReady && (
    <script>
      const status = document.querySelector("[data-copy-status]");
      for (const button of document.querySelectorAll("[data-copy-command]")) {
        button.addEventListener("click", async () => {
          const value = button.getAttribute("data-copy-command");
          if (!value) return;
          try {
            await navigator.clipboard.writeText(value);
            button.textContent = "Copied";
            if (status) status.textContent = "Install command copied.";
          } catch {
            if (status) status.textContent = "Copy failed. Select the command and copy it manually.";
          }
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1600);
        });
      }
    </script>
  )
}
