---
const cases = [
  ["PG", "Remote Compose Postgres", "Publish Postgres only on host loopback, then query it at a stable localhost port."],
  ["AI", "Agent-scoped access", "Give an agent a database socket, not SSH access to the host. Database credentials remain separate."],
  ["ST", "Durable staging route", "Unless-stopped restores after reboot until the host grant expires; manual does not restore after reboot."],
  ["API", "Private TCP service", "Reach an internal API or admin port without publishing it or building a mesh."]
];
---

<div class="use-case-grid">
  {cases.map(([label, title, body]) => (
    <article>
      <span>{label}</span>
      <h3>{title}</h3>
      <p>{body}</p>
    </article>
  ))}
</div>
