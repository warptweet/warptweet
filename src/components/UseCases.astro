---
const cases = [
  ["PG", "Remote Postgres", "Keep a Compose database on host loopback, then query it through a stable port on your Mac."],
  ["API", "Private service", "Reach an internal TCP API or administration port without publishing the service itself."],
  ["AI", "Agent-scoped socket", "Give an agent one database socket instead of a shell or membership in the host network."],
  ["ST", "Durable staging route", "Restore an approved route after reboot, or keep it manually stopped, until the host grant expires."]
];
---

<div class="use-case-grid">
  {cases.map(([label, title, body]) => (
    <article>
      <span>{label}</span>
      <h3>{title}</h3>
      <p>{body}</p>
    </article>
  ))}
</div>
