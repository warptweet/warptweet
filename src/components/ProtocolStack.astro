---
const parts = [
  ["01", "Identity", "Endpoint-generated hybrid host and client identities."],
  ["02", "Manifest", "A versioned .wt definition of machines, routes, and services."],
  ["03", "Profile", "One exact hybrid cryptographic suite shared by both endpoints."],
  ["04", "Tunnel", "A named TCP path from a local listener to the declared destination."],
  ["05", "Lifecycle", "Gateway, invite, connect, readiness, status, and clean shutdown."]
];
---

<ol class="protocol-stack" role="list">
  {parts.map(([number, title, body]) => (
    <li>
      <span>{number}</span>
      <h3>{title}</h3>
      <p>{body}</p>
    </li>
  ))}
</ol>
