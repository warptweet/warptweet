---
import BrandMark from "./BrandMark.astro";

const navigation = [
  { label: "Install", href: "#install" },
  { label: "Features", href: "#features" },
  { label: "Protocol", href: "#protocol" },
  { label: "CLI", href: "#cli" },
  { label: ".wt", href: "#format" }
];
---

<header class="site-header">
  <div class="site-header__inner frame">
    <a class="wordmark" href="/" aria-label="WarpTweet, home">
      <BrandMark />
      <span>WarpTweet</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="header-action" href="#install">Install <span aria-hidden="true">↓</span></a>
  </div>
</header>
