---
import BrandMark from "./BrandMark.astro";

const navigation = [
  { label: "Use cases", href: "#use-cases" },
  { label: "How it works", href: "#how-it-works" },
  { label: "Install", href: "#install" },
  { label: "Protocol", href: "#protocol" }
];
---

<header class="site-header">
  <div class="site-header__inner frame">
    <a class="wordmark" href="/" aria-label="WarpTweet, home">
      <BrandMark />
      <span>WarpTweet</span>
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <ul>
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="header-action" href="#how-it-works">See how it works</a>
  </div>
</header>
